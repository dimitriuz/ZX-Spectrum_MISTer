+/* ======================= zz trace harness ======================= */
+/* Ad-hoc instrumentation for the Scorpion 128-TR-DOS investigation. */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include "screenshot.h"
+#include "peripherals/disk/beta.h"
+#include "zz.h"
+
+int zz_on = 0;
+int zz_mut = 0;
+static int zz_allout = 0;
+int zz_pc_on = 0;
+
+static FILE *zz_fp = NULL;
+static long  zz_pc_left = 0;
+static unsigned long zz_frame = 0;
+static unsigned long zz_instr = 0;
+static unsigned long zz_exit_frame = 0;
+static unsigned long zz_scr_every = 0;
+static char  zz_scr_pfx[400] = "";
+static int   zz_arm_pc = -1;
+static int   zz_arm_7ffd = -1;
+static int   zz_arm_1ffd = -1;
+static int   zz_armed = 0;
+static unsigned long zz_arm_frame = 0;
+static int   zz_verbose = 1;
+static int   zz_keydur = 12;
+static unsigned long zz_dump_frame = 0;
+static char  zz_dump_pfx[400] = "";
+
+#define ZZ_MAXKEYS 64
+static struct { unsigned long frame; int key; } zz_kdown[ ZZ_MAXKEYS ];
+static int zz_nkeys = 0;
+
+static int
+zz_keyname( const char *s )
+{
+  if( !strcasecmp( s, "enter" ) )  return KEYBOARD_Enter;
+  if( !strcasecmp( s, "space" ) )  return KEYBOARD_space;
+  if( !strcasecmp( s, "caps" ) )   return KEYBOARD_Caps;
+  if( !strcasecmp( s, "symbol" ) ) return KEYBOARD_Symbol;
+  if( strlen( s ) == 1 ) {
+    char c = s[0];
+    if( c >= '0' && c <= '9' ) return KEYBOARD_0 + ( c - '0' );
+    if( c >= 'a' && c <= 'z' ) return KEYBOARD_a + ( c - 'a' );
+    if( c >= 'A' && c <= 'Z' ) return KEYBOARD_a + ( c - 'A' );
+  }
+  return 0;
+}
+
+void
+zz_init( void )
+{
+  const char *e;
+  static int done = 0;
+  if( done ) return;
+  done = 1;
+
+  if( ( e = getenv( "ZZ_MUT" ) ) ) zz_mut = strtol( e, NULL, 0 );
+
+  e = getenv( "ZZ_LOG" );
+  if( !e ) return;
+  zz_fp = fopen( e, "w" );
+  if( !zz_fp ) return;
+  setvbuf( zz_fp, NULL, _IOLBF, 0 );
+  zz_on = 1;
+
+  if( ( e = getenv( "ZZ_EXIT" ) ) )      zz_exit_frame = strtoul( e, NULL, 0 );
+  if( ( e = getenv( "ZZ_SCR_EVERY" ) ) ) zz_scr_every  = strtoul( e, NULL, 0 );
+  if( ( e = getenv( "ZZ_SCR" ) ) )       { strncpy( zz_scr_pfx, e, sizeof(zz_scr_pfx)-1 ); }
+  if( ( e = getenv( "ZZ_KEYDUR" ) ) )    zz_keydur     = atoi( e );
+  if( ( e = getenv( "ZZ_DUMP_FRAME" ) ) ) zz_dump_frame = strtoul( e, NULL, 0 );
+  if( ( e = getenv( "ZZ_DUMP" ) ) )      strncpy( zz_dump_pfx, e, sizeof(zz_dump_pfx)-1 );
+  if( ( e = getenv( "ZZ_ARM_PC" ) ) )    zz_arm_pc     = strtol( e, NULL, 16 );
+  if( ( e = getenv( "ZZ_ARM_7FFD" ) ) )  zz_arm_7ffd   = strtol( e, NULL, 16 );
+  if( ( e = getenv( "ZZ_ARM_1FFD" ) ) )  zz_arm_1ffd   = strtol( e, NULL, 16 );
+  if( ( e = getenv( "ZZ_PCMAX" ) ) )     zz_pc_left    = strtol( e, NULL, 0 );
+  if( ( e = getenv( "ZZ_ARM_FRAME" ) ) ) { zz_arm_frame = strtoul( e, NULL, 0 ); zz_verbose = 0; }
+  if( getenv( "ZZ_QUIET" ) ) zz_verbose = 0;
+  if( getenv( "ZZ_ALLOUT" ) ) zz_allout = 1;
+
+  if( ( e = getenv( "ZZ_KEYS" ) ) ) {
+    char buf[1024], *p, *tok;
+    strncpy( buf, e, sizeof(buf)-1 ); buf[sizeof(buf)-1] = 0;
+    p = buf;
+    while( ( tok = strsep( &p, "," ) ) && zz_nkeys < ZZ_MAXKEYS ) {
+      char *colon = strchr( tok, ':' );
+      if( !colon ) continue;
+      *colon = 0;
+      zz_kdown[ zz_nkeys ].frame = strtoul( tok, NULL, 0 );
+      zz_kdown[ zz_nkeys ].key   = zz_keyname( colon + 1 );
+      if( zz_kdown[ zz_nkeys ].key ) zz_nkeys++;
+    }
+  }
+
+  zz_log( "# zz harness: exit=%lu scr_every=%lu keys=%d arm pc=%x 7ffd=%x 1ffd=%x pcmax=%ld",
+          zz_exit_frame, zz_scr_every, zz_nkeys, zz_arm_pc, zz_arm_7ffd, zz_arm_1ffd, zz_pc_left );
+}
+
+int
+zz_verbose_get( void )
+{
+  return zz_verbose;
+}
+
+void
+zz_log( const char *fmt, ... )
+{
+  va_list ap;
+  if( !zz_fp ) return;
+  fprintf( zz_fp, "[%6lu/%10lu] ", zz_frame, zz_instr );
+  va_start( ap, fmt );
+  vfprintf( zz_fp, fmt, ap );
+  va_end( ap );
+  fputc( '\n', zz_fp );
+}
+
+static void
+zz_state( char *out, size_t n )
+{
+  snprintf( out, n, "7ffd=%02x 1ffd=%02x lock=%d rom=%d page=%d spec=%d beta=%d",
+            machine_current->ram.last_byte, machine_current->ram.last_byte2,
+            machine_current->ram.locked, machine_current->ram.current_rom,
+            machine_current->ram.current_page, machine_current->ram.special,
+            beta_active );
+}
+
+void
+zz_out( unsigned port, unsigned val )
+{
+  char s[160];
+  if( !zz_on ) return;
+  /* only the ports that matter: paging + beta */
+  if( zz_allout || ( port & 0x8002 ) == 0x0000 || ( port & 0x00ff ) == 0x00ff ||
+      ( port & 0x00ff ) == 0x001f || ( port & 0x00ff ) == 0x003f ||
+      ( port & 0x00ff ) == 0x005f || ( port & 0x00ff ) == 0x007f ) {
+    zz_state( s, sizeof s );
+    zz_log( "OUT  %04x,%02x  PC=%04x SP=%04x AF=%04x BC=%04x DE=%04x HL=%04x IX=%04x IY=%04x  pre[%s]",
+            port, val, z80.pc.w, z80.sp.w, z80.af.w, z80.bc.w, z80.de.w, z80.hl.w,
+            z80.ix.w, z80.iy.w, s );
+  }
+}
+
+void
+zz_in( unsigned port )
+{
+  if( !zz_on || !zz_allout ) return;
+  zz_log( "IN   %04x  PC=%04x beta=%d", port, z80.pc.w, beta_active );
+}
+
+void
+zz_beta( int paged )
+{
+  char s[160];
+  if( !zz_on ) return;
+  if( zz_verbose ) {
+    zz_state( s, sizeof s );
+    zz_log( "BETA %s PC=%04x [%s]", paged ? "PAGE  " : "UNPAGE", z80.pc.w, s );
+  }
+
+  if( paged && !zz_armed && zz_pc_left > 0 &&
+      ( zz_arm_pc   < 0 || z80.pc.w                       == zz_arm_pc ) &&
+      ( zz_arm_7ffd < 0 || machine_current->ram.last_byte  == zz_arm_7ffd ) &&
+      ( zz_arm_1ffd < 0 || machine_current->ram.last_byte2 == zz_arm_1ffd ) ) {
+    zz_armed = 1;
+    zz_pc_on = 1;
+    zz_log( "ARM  instruction trace, %ld instructions", zz_pc_left );
+  }
+}
+
+void
+zz_pc_hook( void )
+{
+  if( !zz_fp ) return;
+  fprintf( zz_fp, "i %04x %02x %02x %d %d %d\n", z80.pc.w,
+           machine_current->ram.last_byte, machine_current->ram.last_byte2,
+           machine_current->ram.current_rom, machine_current->ram.current_page,
+           beta_active );
+  if( --zz_pc_left <= 0 ) {
+    zz_pc_on = 0;
+    zz_log( "DISARM instruction trace" );
+  }
+}
+
+void
+zz_frame_hook( void )
+{
+  int i;
+  char s[160];
+  if( !zz_on ) return;
+  zz_frame++;
+
+  for( i = 0; i < zz_nkeys; i++ ) {
+    if( zz_kdown[ i ].frame == zz_frame ) {
+      zz_state( s, sizeof s );
+      zz_log( "KEY  down %04x [%s]", zz_kdown[ i ].key, s );
+      keyboard_press( zz_kdown[ i ].key );
+    }
+    if( zz_kdown[ i ].frame + zz_keydur == zz_frame ) {
+      keyboard_release( zz_kdown[ i ].key );
+      zz_log( "KEY  up   %04x", zz_kdown[ i ].key );
+    }
+  }
+
+  if( zz_arm_frame && !zz_armed && zz_frame >= zz_arm_frame ) {
+    zz_armed = 1;
+    zz_verbose = 1;
+    if( zz_pc_left > 0 ) zz_pc_on = 1;
+    zz_log( "ARM  at frame %lu (pc trace %ld)", zz_frame, zz_pc_left );
+  }
+
+  if( zz_scr_every && zz_scr_pfx[0] && ( zz_frame % zz_scr_every ) == 0 ) {
+    char fn[512];
+    snprintf( fn, sizeof fn, "%s%06lu.scr", zz_scr_pfx, zz_frame );
+    screenshot_scr_write( fn );
+  }
+
+  if( ( zz_frame % 50 ) == 0 ) {
+    zz_state( s, sizeof s );
+    zz_log( "TICK [%s]", s );
+  }
+
+  if( zz_dump_frame && zz_frame == zz_dump_frame && zz_dump_pfx[0] ) {
+    int p;
+    for( p = 0; p < 16; p++ ) {
+      char fn[512]; FILE *f;
+      snprintf( fn, sizeof fn, "%spage%02d.bin", zz_dump_pfx, p );
+      f = fopen( fn, "wb" );
+      if( f ) { fwrite( RAM[p], 1, 0x4000, f ); fclose( f ); }
+    }
+    zz_log( "DUMP RAM pages at frame %lu", zz_frame );
+  }
+
+  if( zz_exit_frame && zz_frame >= zz_exit_frame ) {
+    if( zz_scr_pfx[0] ) {
+      char fn[512];
+      snprintf( fn, sizeof fn, "%sfinal.scr", zz_scr_pfx );
+      screenshot_scr_write( fn );
+    }
+    zz_log( "EXIT at frame %lu", zz_frame );
+    fflush( zz_fp );
+    exit( 0 );
+  }
+}
+/* ===================== end zz trace harness ===================== */
